rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Leaderboards are readable by anyone, logged in or not (standard for a
    // leaderboard — you don't need an account to see standings, only to
    // appear on them). No sensitive data lives here: username, score and
    // final resources only, never anything from users/{userId}.
    match /leaderboards/{eraId}/entries/{entryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == entryId;
    }
    // Daily Challenge: one entry per player per era per day. Create-only —
    // no update or delete — so a player can't overwrite a worse score with a
    // better one from a second attempt. {leaderboardId} is "{eraId}-{date}".
    match /dailyLeaderboards/{leaderboardId}/entries/{entryId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == entryId;
      allow update, delete: if false;
    }
  }
}
