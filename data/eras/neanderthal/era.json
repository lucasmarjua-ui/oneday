  "personas": [
    {
      "id": "spear-bearer",
      "trait": "bold",
      "name": {
        "en": "The Spear-Bearer",
        "es": "Portador de la Lanza"
      },
      "description": {
        "en": "Beasts, storms and rivals: you walked toward all of them. The tribe tells your day by the fire.",
        "es": "Bestias, tormentas y rivales: caminaste hacia todos ellos. La tribu cuenta tu día junto al fuego."
      }
    },
    {
      "id": "fire-keeper",
      "trait": "prudent",
      "name": {
        "en": "The Fire-Keeper",
        "es": "Guardián del Fuego"
      },
      "description": {
        "en": "You took no chance the valley did not force on you, and you are alive to say so.",
        "es": "No corriste ningún riesgo que el valle no te obligara a correr, y sigues vivo para contarlo."
      }
    },
    {
      "id": "provider",
      "trait": "generous",
      "name": {
        "en": "The Provider",
        "es": "Proveedor"
      },
      "description": {
        "en": "What you found, you shared. Children, elders and the wounded ate because of you.",
        "es": "Lo que encontraste, lo compartiste. Niños, ancianos y heridos comieron gracias a ti."
      }
    },
    {
      "id": "trapper",
      "trait": "cunning",
      "name": {
        "en": "The Trapper",
        "es": "Trampero"
      },
      "description": {
        "en": "You got what you needed without ever meeting the beast face to face. The tribe is wary of that kind of cleverness.",
        "es": "Conseguiste lo que necesitabas sin enfrentarte nunca a la bestia. La tribu recela de esa clase de astucia."
      }
    },
    {
      "id": "flint-knapper",
      "trait": "diligent",
      "name": {
        "en": "The Flint-Knapper",
        "es": "Tallador de Sílex"
      },
      "description": {
        "en": "Fire tended, hides scraped, edges sharpened: the unglamorous work that keeps a tribe alive was yours today.",
        "es": "Fuego avivado, pieles raspadas, filos afilados: el trabajo poco vistoso que mantiene viva a una tribu fue hoy el tuyo."
      }
    },
    {
      "id": "sign-reader",
      "trait": "curious",
      "name": {
        "en": "The Sign-Reader",
        "es": "Lector de Señales"
      },
      "description": {
        "en": "Smoke, tracks, stars and old stories: you paid attention when others walked past. Kaia sees a shaman in you.",
        "es": "Humo, huellas, estrellas y viejas historias: prestaste atención cuando otros pasaban de largo. Kaia ve en ti a un chamán."
      }
    },
    {
      "id": "drifter",
      "trait": null,
      "name": {
        "en": "The Drifter",
        "es": "Errante"
      },
      "description": {
        "en": "You survived, and little more. The valley asks more of those who want to stay.",
        "es": "Sobreviviste, y poco más. El valle pide más a quienes quieren quedarse."
      }
    }
  ],
