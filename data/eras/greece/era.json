  "personas": [
    {
      "id": "hoplite",
      "trait": "bold",
      "name": {
        "en": "The Hoplite",
        "es": "El Hoplita"
      },
      "description": {
        "en": "You met every challenge head-on, in the gymnasium, the assembly and the street alike. Athens remembers the ones who step forward.",
        "es": "Afrontaste cada reto de frente, en el gimnasio, la asamblea y la calle por igual. Atenas recuerda a quienes dan un paso adelante."
      }
    },
    {
      "id": "stoic",
      "trait": "prudent",
      "name": {
        "en": "The Stoic",
        "es": "El Estoico"
      },
      "description": {
        "en": "You let the loud moments pass and kept what mattered: your health, your coin, your composure.",
        "es": "Dejaste pasar los momentos ruidosos y conservaste lo que importaba: tu salud, tu dinero, tu serenidad."
      }
    },
    {
      "id": "benefactor",
      "trait": "generous",
      "name": {
        "en": "The Benefactor",
        "es": "El Benefactor"
      },
      "description": {
        "en": "Beggars, fishermen and neighbors all left your company a little better off. The city noticed.",
        "es": "Mendigos, pescadores y vecinos salieron de tu compañía un poco mejor. La ciudad se dio cuenta."
      }
    },
    {
      "id": "sophist",
      "trait": "cunning",
      "name": {
        "en": "The Sophist",
        "es": "El Sofista"
      },
      "description": {
        "en": "Every bargain bent your way and every rival ended a step behind. Whether the city admires you is another matter.",
        "es": "Cada trato se inclinó a tu favor y cada rival acabó un paso por detrás. Que la ciudad te admire es otra cuestión."
      }
    },
    {
      "id": "craftsman",
      "trait": "diligent",
      "name": {
        "en": "The Craftsman",
        "es": "El Artesano"
      },
      "description": {
        "en": "Nets, kilns, drills and long hours: you built your day with your hands and it held.",
        "es": "Redes, hornos, ejercicios y largas horas: construiste tu día con las manos y aguantó."
      }
    },
    {
      "id": "philosopher",
      "trait": "curious",
      "name": {
        "en": "The Philosopher",
        "es": "El Filósofo"
      },
      "description": {
        "en": "You listened more than you spoke, and asked more than you answered. Sophia would approve.",
        "es": "Escuchaste más de lo que hablaste y preguntaste más de lo que respondiste. Sofía lo aprobaría."
      }
    },
    {
      "id": "idler",
      "trait": null,
      "name": {
        "en": "The Idler",
        "es": "El Ocioso"
      },
      "description": {
        "en": "The day happened around you more than to you. Tomorrow, choose.",
        "es": "El día ocurrió a tu alrededor más que a ti. Mañana, elige."
      }
    }
  ],
